event RoundOpened(uint256 indexed id,uint256 cutoff,uint256 price,address token,uint256 version); event RoundEconomicsSnapshotted(uint256 indexed id,uint128 ticketPrice,uint64 duration,uint16 jackpotBps,uint16 weeklyBps,uint16 maintenanceBps,uint16 oracleBps,address maintenanceWallet,address oracleWallet); event TicketPurchased(uint256 indexed id,uint256 indexed index,address indexed player,uint32 mask,uint256 paid,uint256 jackpotShare,uint256 weeklyShare,uint256 maintenanceShare,uint256 oracleShare,uint256 dust); event RoundClosed(uint256 indexed id,uint256 count,uint256 cutoff); event RandomnessRequested(uint256 indexed id,uint256 indexed requestId,address coordinator,uint256 version); event RandomnessFulfilled(uint256 indexed id,uint256 indexed requestId,uint32 mask); event DrawMethodRecorded(uint256 indexed id,DrawMethod method,uint256 indexed requestId,uint32 mask); event SettlementProgress(uint256 indexed id,uint256 cursor,uint8 score,uint256 finalists); event RoundSettled(uint256 indexed id,uint32 mask,uint8 score,uint256 finalists,uint256 award,uint256 dust,uint256 rollover); event PrizeClaimed(uint256 indexed id,uint256 indexed offset,address indexed player,uint256 amount); event ManualContingencyExecuted(uint256 indexed id,uint256 indexed requestId,bytes32 reason,bytes32 evidence,address actor); event EmergencyAuthorityChanged(address indexed oldAuthority,address indexed newAuthority); event EmergencyPaused(bool paused,bytes32 reason,address actor); event VrfConfigProposed(uint256 indexed version,bytes32 hash,uint256 at); event VrfConfigActivated(uint256 indexed version,bytes32 hash); event FutureRoundConfigProposed(uint128 ticketPrice,uint64 duration,uint16 jackpotBps,uint16 weeklyBps,uint16 maintenanceBps,uint16 oracleBps,address maintenanceWallet,address oracleWallet,uint256 executableAt); event FutureRoundConfigActivated(uint128 oldTicketPrice,uint64 oldDuration,uint16 oldJackpotBps,uint16 oldWeeklyBps,uint16 oldMaintenanceBps,uint16 oldOracleBps,address oldMaintenanceWallet,address oldOracleWallet,uint128 newTicketPrice,uint64 newDuration,uint16 newJackpotBps,uint16 newWeeklyBps,uint16 newMaintenanceBps,uint16 newOracleBps,address newMaintenanceWallet,address newOracleWallet); event MaintenanceWalletChanged(address indexed oldWallet,address indexed newWallet); event OracleWalletChanged(address indexed oldWallet,address indexed newWallet); event MigrationProposed(address indexed successor,uint256 at); event MigrationCancelled(address indexed successor); event MigrationExecuted(address indexed successor,uint256 amount,uint256 liabilities);
modifier onlyEmergency(){require(msg.sender==emergencyAuthority||msg.sender==owner(),"EMERGENCY");_;} modifier whenNotPaused(){require(!paused,"PAUSED");_;}
constructor(address token,uint8 decimals_,FutureRoundConfig memory initialRound,VrfConfig memory initial,address emergency) VRFConsumerBaseV2Plus(initial.coordinator) {require(token!=address(0)&&initial.coordinator!=address(0),"ZERO_ADDRESS");_validRoundConfig(initialRound);usdt=IERC20MetadataLike(token);require(usdt.decimals()==decimals_,"DECIMALS");usdtDecimals=decimals_;activeRoundConfig=initialRound;maintenanceWallet=initialRound.maintenanceWallet;oracleWallet=initialRound.oracleWallet;emergencyAuthority=emergency==address(0)?msg.sender:emergency;configVersion=1;vrfConfigs[1]=initial;_open();}
function setEmergencyAuthority(address next) external onlyOwner {require(next!=address(0),"ZERO_AUTHORITY");address old=emergencyAuthority;emergencyAuthority=next;emit EmergencyAuthorityChanged(old,next);} function setEmergencyPause(bool next,bytes32 reason) external onlyEmergency {paused=next;emit EmergencyPaused(next,reason,msg.sender);} function proposeFutureRoundConfig(FutureRoundConfig calldata next) external onlyOwner {_validRoundConfig(next);proposedRoundConfig=next;proposedRoundConfigAt=block.timestamp+CONFIG_DELAY;emit FutureRoundConfigProposed(next.ticketPrice,next.roundDuration,next.jackpotBps,next.weeklyBps,next.maintenanceBps,next.oracleBps,next.maintenanceWallet,next.oracleWallet,proposedRoundConfigAt);} function activateFutureRoundConfig() external onlyOwner {require(proposedRoundConfigAt!=0&&block.timestamp>=proposedRoundConfigAt,"CONFIG_TIMELOCK");FutureRoundConfig memory old=activeRoundConfig;FutureRoundConfig memory next=proposedRoundConfig;address oldMaintenance=maintenanceWallet;address oldOracle=oracleWallet;activeRoundConfig=next;maintenanceWallet=next.maintenanceWallet;oracleWallet=next.oracleWallet;emit FutureRoundConfigActivated(old.ticketPrice,old.roundDuration,old.jackpotBps,old.weeklyBps,old.maintenanceBps,old.oracleBps,old.maintenanceWallet,old.oracleWallet,next.ticketPrice,next.roundDuration,next.jackpotBps,next.weeklyBps,next.maintenanceBps,next.oracleBps,next.maintenanceWallet,next.oracleWallet);emit MaintenanceWalletChanged(oldMaintenance,maintenanceWallet);emit OracleWalletChanged(oldOracle,oracleWallet);delete proposedRoundConfigAt;}
function buyTicket(uint32 mask) external nonReentrant whenNotPaused {Round storage r=rounds[currentRoundId];require(migrationState==MigrationState.NORMAL&&r.state==RoundState.OPEN,"SALES_CLOSED");require(block.timestamp<r.cutoffAt,"CUTOFF");require(_valid(mask),"INVALID_TICKET");uint256 before_=usdt.balanceOf(address(this));uint256 p=r.ticketPrice;uint256 j=p*r.jackpotBps/BPS;uint256 w=p*r.weeklyBps/BPS;uint256 m=p*r.maintenanceBps/BPS;uint256 o=p*r.oracleBps/BPS;uint256 d=p-j-w-m-o;IERC20(address(usdt)).safeTransferFrom(msg.sender,address(this),p);require(usdt.balanceOf(address(this))==before_+p,"UNSUPPORTED_TOKEN_BEHAVIOR");IERC20(address(usdt)).safeTransfer(r.maintenanceWallet,m);IERC20(address(usdt)).safeTransfer(r.oracleWallet,o);require(usdt.balanceOf(address(this))==before_+j+w+d,"UNSUPPORTED_TOKEN_BEHAVIOR");r.jackpotContribution+=j;r.weeklyPool+=w;jackpotReserve+=j;unallocatedDustReserve+=d;uint256 i=nextTicketIndex++;tickets[i]=Ticket(msg.sender,mask);r.ticketCount++;emit TicketPurchased(currentRoundId,i,msg.sender,mask,p,j,w,m,o,d);}
function checkUpkeep(bytes calldata) external view override returns(bool,bytes memory){Round storage r=rounds[currentRoundId];if(migrationState!=MigrationState.NORMAL||paused)return(false,"");if(r.state==RoundState.OPEN&&block.timestamp>=r.cutoffAt)return(true,abi.encode(currentRoundId,Action.CLOSE,0));if(r.state==RoundState.CLOSED&&r.ticketCount>0&&r.requestId==0)return(true,abi.encode(currentRoundId,Action.REQUEST,0));if((r.state==RoundState.VRF_RECEIVED||r.state==RoundState.SETTLEMENT)&&r.settlementCursor<r.ticketCount)return(true,abi.encode(currentRoundId,Action.SETTLE,MAX_SETTLEMENT_BATCH));if(r.state==RoundState.COMPLETED)return(true,abi.encode(currentRoundId,Action.OPEN_NEXT,0));return(false,"");}
function performUpkeep(bytes calldata d) external override whenNotPaused {(uint256 id,Action a,uint256 n)=abi.decode(d,(uint256,Action,uint256));require(id==currentRoundId&&migrationState==MigrationState.NORMAL,"STALE_ACTION");if(a==Action.CLOSE)_close(id);else if(a==Action.REQUEST)_request(id);else if(a==Action.SETTLE)_settle(id,n);else if(a==Action.OPEN_NEXT)_next();else revert("UNKNOWN_ACTION");} function closeRound(uint256 id) external whenNotPaused{_close(id);} function requestRandomness(uint256 id) external whenNotPaused{_request(id);} function processSettlement(uint256 id,uint256 n) external whenNotPaused{_settle(id,n);} function openNextRound() external whenNotPaused{_next();}
function _close(uint256 id) internal {Round storage r=rounds[id];require(id==currentRoundId&&r.state==RoundState.OPEN&&block.timestamp>=r.cutoffAt,"NOT_CLOSABLE");r.state=RoundState.CLOSED;r.closedAt=uint64(block.timestamp);r.ticketStart=uint64(nextTicketIndex-r.ticketCount);emit RoundClosed(id,r.ticketCount,r.cutoffAt);if(r.ticketCount==0){r.state=RoundState.COMPLETED;r.completedAt=uint64(block.timestamp);emit RoundSettled(id,0,0,0,0,0,jackpotReserve);}}
function _request(uint256 id) internal {Round storage r=rounds[id];require(id==currentRoundId&&r.state==RoundState.CLOSED&&r.ticketCount>0&&r.requestId==0&&!r.requestPending,"NOT_REQUESTABLE");VrfConfig memory c=vrfConfigs[r.configVersion];require(c.coordinator==address(s_vrfCoordinator),"COORDINATOR_SNAPSHOT");r.state=RoundState.VRF_REQUESTED;r.requestPending=true;r.requestedAt=uint64(block.timestamp);uint256 rid=s_vrfCoordinator.requestRandomWords(VRFV2PlusClient.RandomWordsRequest({keyHash:c.keyHash,subId:c.subscriptionId,requestConfirmations:c.requestConfirmations,callbackGasLimit:c.callbackGasLimit,numWords:c.numWords,extraArgs:VRFV2PlusClient._argsToBytes(VRFV2PlusClient.ExtraArgsV1({nativePayment:c.payWithNative}))}));require(rid!=0&&requestIdToRoundId[rid]==0,"BAD_REQUEST_ID");r.requestId=rid;requestIdToRoundId[rid]=id;emit RandomnessRequested(id,rid,c.coordinator,r.configVersion);}
function fulfillRandomWords(uint256 rid,uint256[] calldata words) internal override {uint256 id=requestIdToRoundId[rid];require(id!=0&&words.length>0,"UNKNOWN_REQUEST");Round storage r=rounds[id];require(r.state==RoundState.VRF_REQUESTED&&r.requestId==rid&&r.requestPending&&r.drawMethod==DrawMethod.NONE,"INVALID_CALLBACK");r.winningMask=_winning(words[0]);r.requestPending=false;r.drawMethod=DrawMethod.CHAINLINK_VRF;r.state=RoundState.VRF_RECEIVED;emit RandomnessFulfilled(id,rid,r.winningMask);emit DrawMethodRecorded(id,DrawMethod.CHAINLINK_VRF,rid,r.winningMask);}
function _settle(uint256 id,uint256 n) internal {Round storage r=rounds[id];require(id==currentRoundId&&(r.state==RoundState.VRF_RECEIVED||r.state==RoundState.SETTLEMENT),"NOT_SETTLING");require(n>0&&n<=MAX_SETTLEMENT_BATCH,"BAD_BATCH");r.state=RoundState.SETTLEMENT;uint256 end=r.settlementCursor+n;if(end>r.ticketCount)end=r.ticketCount;for(uint256 x=r.settlementCursor;x<end;++x){require(!ticketProcessed[id][x],"DUPLICATE_TICKET");ticketProcessed[id][x]=true;uint8 s=_count(tickets[uint256(r.ticketStart)+x].mask&r.winningMask);if(s>r.bestScore){r.bestScore=s;r.finalistCount=1;}else if(s==r.bestScore)r.finalistCount++;}r.settlementCursor=uint64(end);emit SettlementProgress(id,end,r.bestScore,r.finalistCount);if(end==r.ticketCount)_finalize(id);}
function _finalize(uint256 id) internal {Round storage r=rounds[id];require(r.finalistCount>0,"NO_FINALISTS");uint256 a=r.weeklyPool;if(r.bestScore==TICKET_NUMBERS){a+=jackpotReserve;jackpotReserve=0;}uint256 distributed=a-a%r.finalistCount;uint256 dust=a-distributed;r.totalAward=distributed;r.weeklyPool=0;playerLiabilities+=distributed;jackpotReserve+=dust;r.state=RoundState.COMPLETED;r.completedAt=uint64(block.timestamp);emit RoundSettled(id,r.winningMask,r.bestScore,r.finalistCount,distributed,dust,jackpotReserve);}
function claim(uint256 id,uint256 offset) external nonReentrant {Round storage r=rounds[id];require(r.state==RoundState.COMPLETED&&offset<r.ticketCount,"NOT_CLAIMABLE");Ticket storage t=tickets[uint256(r.ticketStart)+offset];require(t.player==msg.sender&&!ticketClaimed[id][offset],"NOT_TICKET_OWNER");require(_count(t.mask&r.winningMask)==r.bestScore,"NOT_WINNER");uint256 a=r.totalAward/r.finalistCount;require(a>0,"NO_AWARD");ticketClaimed[id][offset]=true;playerLiabilities-=a;IERC20(address(usdt)).safeTransfer(msg.sender,a);emit PrizeClaimed(id,uint256(r.ticketStart)+offset,msg.sender,a);}
function executeManualContingency(uint256 id,uint256 entropy,bytes32 reason,bytes32 evidence) external onlyEmergency nonReentrant {Round storage r=rounds[id];require(r.state==RoundState.VRF_REQUESTED&&r.requestId!=0&&r.drawMethod==DrawMethod.NONE&&block.timestamp>=r.requestedAt+VRF_TIMEOUT,"VRF_STILL_PROGRESSING");r.state=RoundState.EMERGENCY;r.requestPending=false;r.drawMethod=DrawMethod.MANUAL_CONTINGENCY;r.manualReasonHash=reason;r.manualEvidenceHash=evidence;r.winningMask=_winning(uint256(keccak256(abi.encode(entropy,reason,evidence,block.prevrandao,id))));emit ManualContingencyExecuted(id,r.requestId,reason,evidence,msg.sender);emit DrawMethodRecorded(id,DrawMethod.MANUAL_CONTINGENCY,r.requestId,r.winningMask);r.state=RoundState.VRF_RECEIVED;}
function proposeFutureVrfConfig(VrfConfig calldata next) external onlyOwner {require(next.coordinator==address(s_vrfCoordinator),"COORDINATOR_SNAPSHOT");proposedVrfConfig=next;proposedConfigAt=block.timestamp+CONFIG_DELAY;emit VrfConfigProposed(configVersion+1,keccak256(abi.encode(next)),proposedConfigAt);} function activateFutureVrfConfig() external onlyOwner {require(proposedConfigAt!=0&&block.timestamp>=proposedConfigAt,"CONFIG_TIMELOCK");configVersion++;vrfConfigs[configVersion]=proposedVrfConfig;emit VrfConfigActivated(configVersion,keccak256(abi.encode(proposedVrfConfig)));delete proposedConfigAt;} function vrfConfig(uint256 v) external view returns(VrfConfig memory){return vrfConfigs[v];}
function proposeMigration(address successor) external onlyOwner {require(migrationState==MigrationState.NORMAL&&successor!=address(0)&&successor.code.length>0,"BAD_SUCCESSOR");require(IMigrationReceiverV2(successor).migrationReceiverMagic(address(usdt),block.chainid)==MIGRATION_MAGIC,"HANDSHAKE");proposedSuccessor=successor;migrationProposedAt=block.timestamp;migrationExecutableAt=block.timestamp+MIGRATION_DELAY;migrationState=MigrationState.MIGRATION_PROPOSED;emit MigrationProposed(successor,migrationExecutableAt);} function cancelMigration() external onlyOwner {require(migrationState==MigrationState.MIGRATION_PROPOSED,"NO_MIGRATION");address x=proposedSuccessor;proposedSuccessor=address(0);migrationProposedAt=0;migrationExecutableAt=0;migrationState=MigrationState.NORMAL;emit MigrationCancelled(x);} function executeMigration() external onlyOwner nonReentrant {require(migrationState==MigrationState.MIGRATION_PROPOSED&&block.timestamp>=migrationExecutableAt,"MIGRATION_TIMELOCK");require(rounds[currentRoundId].state==RoundState.COMPLETED,"ACTIVE_ROUND");migrationState=MigrationState.MIGRATION_READY;uint256 a=migratableBalance();IERC20(address(usdt)).safeTransfer(proposedSuccessor,a);IMigrationReceiverV2(proposedSuccessor).receiveMigration(address(usdt),a);migrationState=MigrationState.MIGRATED_CLAIMS_ONLY;emit MigrationExecuted(proposedSuccessor,a,playerLiabilities);}
function futureTicketPrice() external view returns(uint128){return activeRoundConfig.ticketPrice;} function futureRoundDuration() external view returns(uint64){return activeRoundConfig.roundDuration;} function futureAllocationBps() external view returns(uint16,uint16,uint16,uint16){FutureRoundConfig memory c=activeRoundConfig;return(c.jackpotBps,c.weeklyBps,c.maintenanceBps,c.oracleBps);} function proposedFutureRoundConfig() external view returns(FutureRoundConfig memory,uint256){return(proposedRoundConfig,proposedRoundConfigAt);} function protectedReserves() public view returns(uint256){return jackpotReserve+unallocatedDustReserve+rounds[currentRoundId].weeklyPool;} function migratableBalance() public view returns(uint256){uint256 b=usdt.balanceOf(address(this));return b>playerLiabilities?b-playerLiabilities:0;} function solvency() external view returns(uint256 b,uint256 p,bool ok){b=usdt.balanceOf(address(this));p=playerLiabilities+protectedReserves();ok=p<=b;}
function drawEvidence(uint256 id) external view returns(DrawMethod,uint32,uint256,address,uint256,uint256,uint256,uint8,uint256,uint256,bytes32,bytes32){Round storage r=rounds[id];return(r.drawMethod,r.winningMask,r.requestId,vrfConfigs[r.configVersion].coordinator,r.configVersion,r.requestedAt,r.completedAt,r.bestScore,r.finalistCount,r.totalAward,r.manualReasonHash,r.manualEvidenceHash);} function ticketEntitlement(uint256 id,uint256 offset) external view returns(address,uint32,uint8,bool,uint256,bool){Round storage r=rounds[id];require(offset<r.ticketCount,"TICKET_OFFSET");Ticket storage t=tickets[uint256(r.ticketStart)+offset];uint8 s=_count(t.mask&r.winningMask);bool w=r.state==RoundState.COMPLETED&&s==r.bestScore&&r.totalAward>0;bool c=ticketClaimed[id][offset];return(t.player,t.mask,s,w,w&&!c?r.totalAward/r.finalistCount:0,c);}
function _next() internal {require(rounds[currentRoundId].state==RoundState.COMPLETED&&migrationState==MigrationState.NORMAL,"NOT_OPENABLE");_open();} function _open() internal {FutureRoundConfig memory c=activeRoundConfig;currentRoundId++;Round storage r=rounds[currentRoundId];r.state=RoundState.OPEN;r.openedAt=uint64(block.timestamp);r.duration=c.roundDuration;r.cutoffAt=uint64(block.timestamp+c.roundDuration);r.ticketPrice=c.ticketPrice;r.jackpotBps=c.jackpotBps;r.weeklyBps=c.weeklyBps;r.maintenanceBps=c.maintenanceBps;r.oracleBps=c.oracleBps;r.maintenanceWallet=c.maintenanceWallet;r.oracleWallet=c.oracleWallet;r.configVersion=configVersion;emit RoundOpened(currentRoundId,r.cutoffAt,c.ticketPrice,address(usdt),configVersion);emit RoundEconomicsSnapshotted(currentRoundId,c.ticketPrice,c.roundDuration,c.jackpotBps,c.weeklyBps,c.maintenanceBps,c.oracleBps,c.maintenanceWallet,c.oracleWallet);} function _validRoundConfig(FutureRoundConfig memory c) internal pure {require(c.ticketPrice>0&&c.roundDuration>=1 days&&c.maintenanceWallet!=address(0)&&c.oracleWallet!=address(0),"BAD_ROUND_CONFIG");require(uint256(c.jackpotBps)+c.weeklyBps+c.maintenanceBps+c.oracleBps==BPS,"BPS_SUM");} function _winning(uint256 word) internal pure returns(uint32 mask){uint256 selected;uint256 nonce;while(selected<TICKET_NUMBERS){uint32 bit=uint32(1<<(uint256(keccak256(abi.encode(word,nonce++)))%MAX_NUMBER));if(mask&bit==0){mask|=bit;selected++;}}} function _valid(uint32 x) internal pure returns(bool){return x>>MAX_NUMBER==0&&_count(x)==TICKET_NUMBERS;} function _count(uint32 x) internal pure returns(uint8 n){while(x!=0){n++;x&=x-1;}}
}
