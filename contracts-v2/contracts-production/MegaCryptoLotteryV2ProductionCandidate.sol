IERC20MetadataLike public immutable usdt; uint8 public immutable usdtDecimals; address public emergencyAuthority; address public maintenanceWallet; address public oracleWallet; bool public paused; uint256 public currentRoundId; uint256 public nextTicketIndex; uint256 public jackpotReserve; uint256 public unallocatedDustReserve; uint256 public playerLiabilities; uint256 public configVersion; FutureRoundConfig public activeRoundConfig; FutureRoundConfig private proposedRoundConfig; uint256 public proposedRoundConfigAt;
