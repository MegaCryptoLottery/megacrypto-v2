# Polygon Amoy deployment package — placeholders only. Never put a private key,
# seed phrase, password, or wallet secret in this repository or this file.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
AMOY_LOTTERY_ADDRESS=
AMOY_MOCK_USDT_ADDRESS=
AMOY_SUBSCRIPTION_ID=
# Supply only reviewed user-controlled addresses after separate authorization.
AMOY_MAINTENANCE_WALLET=PENDING_USER_ADDRESS
AMOY_ORACLE_WALLET=PENDING_USER_ADDRESS
AMOY_EMERGENCY_AUTHORITY=PENDING_USER_ADDRESS
# This package intentionally has no signing implementation. AMOY_BROADCAST is
# rejected even if set to CONFIRM; use a wallet-controlled signer after explicit authorization.
AMOY_BROADCAST=
